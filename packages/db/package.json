{
  "name": "@nextdocs/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/indice.js",
  "types": "./dist/indice.d.ts",
  "exports": {
    ".": {
      "types": "./dist/indice.d.ts",
      "default": "./dist/indice.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrar": "tsx --env-file-if-exists=../../.env src/migrar.ts",
    "sembrar": "tsx --env-file-if-exists=../../.env src/sembrar.ts",
    "test:integracion": "vitest run",
    "limpiar": "tsx --env-file-if-exists=../../.env src/limpiar.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "@nextdocs/dominio": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}

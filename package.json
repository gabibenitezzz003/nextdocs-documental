{
  "name": "nextdocs-documental",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integracion": "turbo run test:integracion --concurrency=1",
    "db:migrar": "pnpm --filter @nextdocs/db migrar",
    "db:sembrar": "pnpm --filter @nextdocs/db sembrar",
    "infra:arriba": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:abajo": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:limpiar": "docker compose -f infra/docker/docker-compose.yml down -v",
    "api": "pnpm --filter @nextdocs/api inicio",
    "worker": "pnpm --filter @nextdocs/worker inicio",
    "db:limpiar": "pnpm --filter @nextdocs/db limpiar",
    "db:vaciar": "pnpm --filter @nextdocs/db limpiar -- --catalogo --destinatarios"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}

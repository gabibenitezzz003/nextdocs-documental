{
  "name": "docvance-ai",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integracion": "turbo run test:integracion",
    "db:migrar": "pnpm --filter @docvance/db migrar",
    "db:sembrar": "pnpm --filter @docvance/db sembrar",
    "infra:arriba": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:abajo": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:limpiar": "docker compose -f infra/docker/docker-compose.yml down -v"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "vitest": "^2.1.2",
    "eslint": "^9.12.0"
  }
}
